VITE_API_BASE_URL=https://api.hocluc.com

# Google OAuth Client ID (public, safe to expose in frontend builds).
# Required for the "Đăng nhập với Google" button - without it, that button
# renders a disabled "hiện chưa khả dụng" state instead of crashing.
# NEVER put a Google Client Secret here or anywhere in the frontend.
VITE_GOOGLE_CLIENT_ID=
